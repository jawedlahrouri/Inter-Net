{
  "name": "inter-net",
  "version": "1.0.0",
  "description": "INTER-NET project - FastAPI backend & React Vite frontend",
  "homepage": "https://github.com/Crabe-Corp/INTER-NET#readme",
  "bugs": {
    "url": "https://github.com/Crabe-Corp/INTER-NET/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Crabe-Corp/INTER-NET.git"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "dev:backend": "bash -c 'cd backend && source .venv/bin/activate && uvicorn app.main:app --reload --port 8000'",
    "test:backend": "bash -c 'cd backend && source .venv/bin/activate && pytest'",
    "install:all": "bash -c 'cd backend && uv venv --python 3.12 .venv && uv pip install -e \".[dev]\" && cd ../frontend && npm install'"
  }
}
